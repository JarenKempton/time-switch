{
  "name": "@time-switch/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "deploy": "vite build && wrangler deploy --strict",
    "deploy:check": "vite build && wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "dev": "vite dev",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "migrate:generate": "drizzle-kit generate",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "0.45.2",
    "esptool-js": "0.6.1",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/vitest-plugin": "1.1.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-serial": "1.0.6",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.10",
    "prettier": "3.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
