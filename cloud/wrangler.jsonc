{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "time-switch",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "time.jarenkempton.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/device/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TIME_CLOCK",
        "class_name": "TimeClock",
      },
    ],
  },
  "exports": {
    "TimeClock": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "vars": {
    "DEVICE_ID": "desk-panel",
  },
}
